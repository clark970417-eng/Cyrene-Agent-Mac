{
  "name": "live2d-cyrene",
  "version": "1.0.0",
  "description": "Live2D desktop pet — Cyrene",
  "main": "dist/main/main/index.js",
  "bin": {
    "cyrene": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.57",
    "@ag-ui/core": "^0.0.57",
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.3.2",
    "@ant-design/x": "^2.9.0",
    "@ant-design/x-markdown": "^2.9.0",
    "@anthropic-ai/sdk": "^0.115.0",
    "@cline/sdk": "0.0.66",
    "@discord/embedded-app-sdk": "^2.5.0",
    "@discordjs/voice": "^0.19.2",
    "@lancedb/lancedb": "^0.30.0",
    "@langchain/anthropic": "^1.5.2",
    "@langchain/core": "^1.2.3",
    "@langchain/deepseek": "^1.1.5",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/openai": "^1.5.5",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@node-rs/jieba": "^2.0.1",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@supabase/supabase-js": "^2.110.8",
    "@xenova/transformers": "^2.17.2",
    "antd": "^6.5.2",
    "chart.js": "^4.5.1",
    "discord.js": "^14.27.0",
    "docx": "^9.7.1",
    "dompurify": "^3.4.13",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.3.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.2.3",
    "langchain": "^1.5.4",
    "llamaindex": "^0.12.1",
    "marked": "^16.4.2",
    "nodemailer": "^9.0.1",
    "openai": "^6.49.0",
    "opencc-js": "^1.4.1",
    "opusscript": "^0.0.8",
    "pdfkit": "^0.19.1",
    "pixi-live2d-display": "0.5.0-beta",
    "pixi.js": "^7.3.0",
    "playwright": "^1.60.0",
    "prism-media": "^1.3.5",
    "qr-image": "^3.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "^7.8.1",
    "shiki": "^4.3.1",
    "silk-wasm": "^3.7.1",
    "turndown": "^7.2.4",
    "wink-bm25-text-search": "^3.1.2",
    "ws": "^8.21.0"
  },
  "allowScripts": {
    "protobufjs@7.6.4": true,
    "protobufjs@6.11.6": true,
    "electron@43.1.0": true,
    "esbuild@0.21.5": true,
    "sharp@0.32.6": true,
    "tree-sitter@0.22.4": true
  },
  "scripts": {
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit --incremental false",
    "typecheck:preload": "tsc -p tsconfig.preload.json --noEmit --incremental false",
    "typecheck:skills": "tsc -p tsconfig.skills.json --noEmit",
    "typecheck": "npm run typecheck:main && npm run typecheck:preload && npm run typecheck:skills",
    "verify": "npm run typecheck && npm run lint -- --quiet && npm test",
    "build:main": "tsc -p tsconfig.main.json && node -e \"require('fs').cpSync('src/main/orchestrator/code/cline-esm-bridge.mjs','dist/main/main/orchestrator/code/cline-esm-bridge.mjs')\"",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:electron": "concurrently --kill-others-on-fail \"npm:build:main\" \"npm:build:preload\"",
    "build:renderer": "vite build",
    "build:skills": "tsc -p tsconfig.skills.json",
    "build:cli": "node scripts/build-cli.mjs",
    "build:screenshot-helper": "node scripts/build-screenshot-helper.mjs",
    "verify:screenshot-helper": "node scripts/verify-screenshot-helper.mjs resources/bin/cyrene-screenshot.exe",
    "build": "npm run build:skills && npm run build:main && npm run build:preload && npm run build:cli && npm run build:renderer",
    "package:win:dir": "npm run build && npm run build:screenshot-helper && electron-builder --win --dir",
    "dev:no-electron": "vite",
    "dev:runtime": "concurrently --kill-others \"vite\" \"cross-env VITE_DEV=1 electron .\"",
    "dev:headless": "npm run build:skills && npm run build:electron && npm run build:cli && concurrently --kill-others \"vite\" \"cross-env VITE_DEV=1 HEADLESS=1 electron .\"",
    "dev:electron": "npm run build:skills && npm run build:electron && npm run build:cli && concurrently --kill-others \"vite\" \"cross-env VITE_DEV=1 electron .\"",
    "dev": "npm run dev:electron",
    "start": "electron .",
    "test": "vitest run",
    "test:watchers": "cross-env CYRENE_RUN_FS_WATCH_TESTS=1 vitest run src/main/orchestrator/code/code-audit-fixes.test.ts src/main/memory/obsidian-importer-watcher.test.ts",
    "test:watch": "vitest",
    "smoke:music": "npm run build:main && node scripts/run-music-smoke.mjs",
    "build:sim": "tsc -p tsconfig.sim.json",
    "sim": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/dmae-sim.js",
    "sim:coffee": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/dmae-sim.js --scenario=coffee",
    "sim:mix": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/dmae-sim.js --scenario=mix",
    "sim:rescue": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/dmae-sim.js --scenario=rescue",
    "sim:sweep": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/dmae-sim.js --scenario=mix --rewardGain=3,5,7,10",
    "sim:l2": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/run-l2-sim.js",
    "pack:dir": "npm run build && electron-builder --mac --dir",
    "dist:mac": "bash scripts/package-mac.sh",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"cloud-bot/src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"cloud-bot/src/**/*.ts\" --fix",
    "lint:all": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@eslint/js": "^9.17.0",
    "@types/dompurify": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qr-image": "^3.2.11",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.15.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0",
    "vite": "7.3.6",
    "vitest": "^4.1.9"
  }
}
